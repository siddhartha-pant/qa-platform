# ============================================================
# AskAnon – Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ----- MongoDB -----------------------------------------------
# Get a free cluster at https://cloud.mongodb.com
# Replace with your connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.abcde.mongodb.net/qa-platform?retryWrites=true&w=majority

# ----- NextAuth.js -------------------------------------------
# URL of your app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars-long

# ----- Optional: Redis (for production rate limiting) ---------
# If set, rate limiter will use Redis instead of in-memory storage
# REDIS_URL=redis://localhost:6379